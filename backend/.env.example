# TerraBela Farm backend - configuração de exemplo (SEM SEGREDOS REAIS).
# Copie para ".env" na pasta PRIVADA do backend (fora do public_html) e preencha.
# Nunca versione o .env nem o coloque dentro da pasta pública.

# local | staging | production (também separa as versões de Remote Config)
APP_ENV=production
# Chave aleatória de 64 caracteres hex: gere com  php -r "echo bin2hex(random_bytes(32));"
# ou use o gerador do passo a passo. Trocar a chave invalida todas as sessões e visitantes.
APP_KEY=
# Endereço público (usado no link de configuração do backoffice), ex.: https://skyplan.com.br/terrabelafarm
APP_URL=

# MySQL (dados do painel da hospedagem)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Sessões (segundos)
ACCESS_TOKEN_TTL=3600
REFRESH_TOKEN_TTL=2592000

# Save na nuvem
SAVE_HISTORY=10
SAVE_MAX_BYTES=262144
DELETION_GRACE_DAYS=30

# Rate limit por minuto
RATE_AUTH_PER_MINUTE=20
RATE_PLAYER_PER_MINUTE=120
RATE_IAP_PER_MINUTE=10
RATE_PUBLIC_PER_MINUTE=120
RATE_ADMIN_LOGIN_PER_MINUTE=10
# IP real do jogador para rate limit: 0 = REMOTE_ADDR; cloudflare = CF-Connecting-IP só quando a conexão
# vem de um IP da Cloudflare (use em skyplan.com.br); 1 = X-Forwarded-For (somente atrás de proxy próprio)
TRUST_PROXY=cloudflare

# Opcional: pasta de logs/cache (padrão: storage/ dentro da pasta privada)
STORAGE_DIR=

# Login Google: client IDs aceitos como audience do ID token (separados por vírgula)
GOOGLE_CLIENT_IDS=
# Login Facebook
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Google Play Billing (validação de compras)
ANDROID_PACKAGE_NAME=com.terrabela.farm
# Caminho ABSOLUTO do JSON da conta de serviço, fora do public_html
GOOGLE_PLAY_SERVICE_ACCOUNT_FILE=
# RTDN (Pub/Sub push com autenticação OIDC)
RTDN_AUDIENCE=
RTDN_SERVICE_ACCOUNT_EMAIL=

# Push (Firebase Cloud Messaging HTTP v1): JSON da conta de serviço com papel "Firebase Cloud Messaging API Admin",
# caminho ABSOLUTO fora do public_html. Sem ele o cron não envia campanhas (fica registrado como fcm_configured=0).
FCM_SERVICE_ACCOUNT_FILE=
# Opcional: id do projeto Firebase (padrão: project_id do JSON acima)
FCM_PROJECT_ID=
# Máximo de pushes promocionais por jogador em 7 dias
PUSH_PROMO_WEEKLY_CAP=3

# Backoffice (/admin): minutos sem uso até expirar e horas de sessão máxima
ADMIN_IDLE_MINUTES=30
ADMIN_SESSION_HOURS=12
