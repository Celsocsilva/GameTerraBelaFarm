; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="TerraBela Farm"
config/icon="res://assets/icons/ico_terrabelafarm.png"
run/main_scene="res://scenes/core/loading_screen.tscn"
boot_splash/bg_color=Color(0.96, 0.72, 0.42, 1)
boot_splash/image="res://assets/ui/loading/loading_screen.png"
boot_splash/stretch_mode=4
boot_splash/show_image=true
config/features=PackedStringArray("4.7", "Mobile")

[autoload]

App="*res://scripts/core/app.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[editor_plugins]

enabled=PackedStringArray("res://addons/meshy-godot-plugin/plugin.cfg")

[internationalization]

locale/translations=PackedStringArray("res://localization/ui.pt_BR.translation", "res://localization/ui.es.translation", "res://localization/ui.en.translation")
locale/fallback="pt_BR"

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size.mobile=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=2
